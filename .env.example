# Enterprise Log Analyzer — overrides por variable de entorno
#
#   cp .env.example .env
#
# Las variables de entorno tienen PRIORIDAD sobre config.yaml.
# Solo es necesario definir lo que quieras sobreescribir.

# --- Rutas --------------------------------------------------------------
# Ruta base del proyecto. Default: la raíz del repo (padre de app/).
# Necesario en Docker, donde el CWD no es el repo.
#ELA_PROJECT_ROOT=/app

# Directorio de logs (solo lectura en Docker).
#ELA_LOG_DIR=/logs

# Ruta del archivo SQLite. En Docker debe vivir en el volumen compartido.
#ELA_DB_PATH=/data/app.db

# Directorio de reportes exportados.
#ELA_EXPORT_DIR=/exports

# --- Ingesta ------------------------------------------------------------
#ELA_POLL_INTERVAL_SECONDS=5
#ELA_DEBOUNCE_SECONDS=2.0
#ELA_CHUNK_BYTES=1048576
# Timezone asumida si el log no declara la suya.
#ELA_DEFAULT_TIMEZONE=UTC

# --- Base de datos ------------------------------------------------------
#ELA_JOURNAL_MODE=wal
#ELA_BUSY_TIMEOUT_MS=5000
#ELA_SYNCHRONOUS=NORMAL

# --- Análisis -----------------------------------------------------------
# Severidad mínima para candidata a incidente (40 = WARN).
#ELA_MIN_INCIDENT_SEVERITY=40
# Ventana de evaluación de umbrales, en minutos.
#ELA_WINDOW_MINUTES=15
# Eventos del mismo fingerprint en la ventana para abrir incidente.
#ELA_INCIDENT_THRESHOLD=50
# Silencio antes de re-notificar, en minutos.
#ELA_COOLDOWN_MINUTES=10
# Z-score mínimo para marcar un pico horario como anomalía.
#ELA_ANOMALY_ZSCORE=3.0

# --- Dashboard ----------------------------------------------------------
#ELA_CACHE_TTL_SECONDS=30
#ELA_DEFAULT_PAGE_SIZE=100